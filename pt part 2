    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const container = document.getElementById('carousel-container');
            const slides = Array.from(container.children);

            // Clone the first and last slides for seamless looping
            const firstClone = slides[0].cloneNode(true);
            const lastClone = slides[slides.length - 1].cloneNode(true);

            // Add clones to the carousel
            container.appendChild(firstClone);
            container.insertBefore(lastClone, slides[0]);

            const allSlides = Array.from(container.children); // Update the slides array
            const slideWidth = allSlides[0].getBoundingClientRect().width; // Get dynamic slide width
            let currentSlide = 1; // Start on the first real slide

            // Set container to show the first real slide
            container.style.transform = `translateX(-${currentSlide * slideWidth}px)`;

            function moveCarousel(direction) {
                currentSlide += direction;
                container.style.transition = "transform 0.5s ease-in-out";
                container.style.transform = `translateX(-${currentSlide * slideWidth}px)`;

                // Handle boundary transitions
                container.addEventListener("transitionend", () => {
                    if (currentSlide === allSlides.length - 1) {
                        container.style.transition = "none"; // Disable transition
                        currentSlide = 1; // Reset to the first real slide
                        container.style.transform = `translateX(-${currentSlide * slideWidth}px)`;
                    } else if (currentSlide === 0) {
                        container.style.transition = "none"; // Disable transition
                        currentSlide = allSlides.length - 2; // Reset to the last real slide
                        container.style.transform = `translateX(-${currentSlide * slideWidth}px)`;
                    }
                });
            }

            // Attach event listeners to navigation buttons
            document.querySelector('.prev').addEventListener('click', () => moveCarousel(-1));
            document.querySelector('.next').addEventListener('click', () => moveCarousel(1));

            // Ensure the slide width updates dynamically on window resize
            window.addEventListener('resize', () => {
                const newSlideWidth = allSlides[0].getBoundingClientRect().width;
                container.style.transform = `translateX(-${currentSlide * newSlideWidth}px)`;
            });
        });
    </script>
